# Copy to `.env` next to docker-compose.prod.yml and fill in.
# `.env` holds the ledger signing key and the chaos token — never commit it.

# Domain pointing at this EC2 host's public IP. Caddy issues the TLS
# certificate for it, so DNS must resolve BEFORE `docker compose up`.
GANGLION_DOMAIN=ganglion.example.com

# Signs the tamper-evident ledger. Generate with:  openssl rand -hex 32
# Changing it invalidates every existing chain, so set it once, before the
# first write, and keep it. The server boots without it but falls back to a
# built-in dev key, which proves nothing against anyone who has read the
# source.
GANGLION_HMAC_KEY=

# The live kill-node demo. Leave chaos at 0 for a normal deployment; the
# endpoints stay dark. Set to 1 only for the demo host, and only together
# with a real token (the server refuses to boot with 1 and no token).
# Generate with:  openssl rand -hex 24
GANGLION_ENABLE_CHAOS=0
GANGLION_ADMIN_TOKEN=
